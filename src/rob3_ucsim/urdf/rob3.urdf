<?xml version="1.0"?>
<!-- ROB3 6-axis robot description - Clean URDF Version -->
<robot name="rob3">

  <material name="rob3_grey">
    <color rgba="0.6 0.6 0.62 1"/>
  </material>
  <material name="rob3_blue">
    <color rgba="0.15 0.35 0.7 1"/>
  </material>

  <!-- Base Link: height 190 mm, width 120 mm, length 200 mm -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0.095" rpy="0 0 0"/>
      <geometry>
        <box size="0.20 0.12 0.190"/>
      </geometry>
      <material name="rob3_grey"/>
    </visual>
  </link>

  <!-- Link 1 (replaces xacro cyl_link) -->
  <link name="link1">
    <visual>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.20" radius="0.03"/>
      </geometry>
      <material name="rob3_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.10" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.20" radius="0.03"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Link 2 (replaces xacro cyl_link) -->
  <link name="link2">
    <visual>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.13" radius="0.025"/>
      </geometry>
      <material name="rob3_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.065" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.13" radius="0.025"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Link 3 (replaces xacro cyl_link) -->
  <link name="link3">
    <visual>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.022"/>
      </geometry>
      <material name="rob3_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.025" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.05" radius="0.022"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Link 4 (replaces xacro cyl_link) -->
  <link name="link4">
    <visual>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
      <material name="rob3_grey"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.02" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Link 5 (replaces xacro cyl_link) -->
  <link name="link5">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.018"/>
      </geometry>
      <material name="rob3_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <cylinder length="0.02" radius="0.018"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="1e-3" ixy="0" ixz="0" iyy="1e-3" iyz="0" izz="1e-3"/>
    </inertial>
  </link>

  <!-- Gripper Link -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0"/>
      <geometry>
        <box size="0.03 0.05 0.02"/>
      </geometry>
      <material name="rob3_grey"/>
    </visual>
  </link>

  <!-- Axis 0: base rotation (q1) +80..-80 deg -->
  <joint name="base" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="0 0 0.190" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.3962634" upper="1.3962634" effort="10" velocity="1.0"/>
  </joint>

  <!-- Axis 1: shoulder (q2) +70..-30 deg -->
  <joint name="shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 0 0.20" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5235987" upper="1.2217304" effort="10" velocity="1.0"/>
  </joint>

  <!-- Axis 2: elbow (q3) 0..-100 deg -->
  <joint name="elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0 0 0.13" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7453292" upper="0.0" effort="8" velocity="1.0"/>
  </joint>

  <!-- Axis 3: wrist pitch (q4) +/-100 deg -->
  <joint name="wrist_pitch" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0 0 0.05" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="5" velocity="1.5"/>
  </joint>

  <!-- Axis 4: wrist roll (q5) +/-100 deg -->
  <joint name="wrist_roll" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0 0 0.04" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="5" velocity="1.5"/>
  </joint>

  <!-- Axis 5: gripper linear opening 0..60 mm (prismatic) -->
  <joint name="gripper" type="prismatic">
    <parent link="link5"/>
    <child link="gripper_link"/>
    <origin xyz="0 0 0.02" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="0.0" upper="0.060" effort="20" velocity="0.05"/>
  </joint>

</robot>

