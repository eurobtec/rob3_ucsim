<?xml version="1.0"?>
<!-- ROB3 6-axis robot description - mesh-based, synced to the TR5 3D CAD.

     SOURCE OF TRUTH: the TR5_Roboterarm 3D CAD
     (github.com/Fuchsfuchsfuchs/TR5_Roboterarm, 3D_CAD/TR5_Modell_V1.*).
     The lower 3 axes use the CAD meshes and the CAD-derived link/joint
     transforms (Fusion 360 export). Mesh units are mm -> scale 0.001.

     COMPLETENESS GAP (per 3D_CAD/Information): the CAD model is work in
     progress - the GRIPPER and the two WRIST axes are NOT modelled. Those
     three links (wrist_pitch, wrist_roll, gripper) are PRIMITIVE STAND-INS
     here, clearly marked, so the simulation keeps all six firmware axes.
     Replace them with CAD meshes once the 3D model is completed.

     Provenance:
       [HW/CAD] base_link, tower, upperarm, forearm  (meshes + transforms)
       [INFER]  wrist_pitch, wrist_roll, gripper      (stand-in primitives)

     Joint NAMES and limits are the firmware axis order (see axes.py / README):
       base +80..-80 deg | shoulder +70..-30 | elbow 0..-100
       wrist_pitch +/-100 | wrist_roll +/-100 | gripper 0..60 mm (prismatic)
     The pybullet/text viewers look joints up BY NAME, so these must not change.
-->
<robot name="rob3">

  <material name="rob3_black">
    <!-- base + gripper are black -->
    <color rgba="0.12 0.12 0.13 1"/>
  </material>
  <material name="rob3_red">
    <!-- tower + upper arm + forearm are red -->
    <color rgba="0.70 0.10 0.12 1"/>
  </material>

  <!-- ================= CAD links (source of truth) ================= -->

  <!-- base_link [HW/CAD]: TR5 base_link.stl -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rob3_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/base_link.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.12 0 0.067" rpy="0 0 0"/>
      <mass value="20.36"/>
      <inertia ixx="0.039666" iyy="0.111871" izz="0.126618" ixy="0" iyz="0" ixz="2e-05"/>
    </inertial>
  </link>

  <!-- tower / Turm [HW/CAD]: TR5_Modell_V1_Turm_v5_1.stl -->
  <link name="link1">
    <visual>
      <origin xyz="0.035 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tower.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rob3_red"/>
    </visual>
    <collision>
      <origin xyz="0.035 0 -0.1" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/tower.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.015 0 0.074" rpy="0 0 0"/>
      <mass value="2.5676"/>
      <inertia ixx="0.013649" iyy="0.014024" izz="0.007713" ixy="0" iyz="-1e-06" ixz="-0.000433"/>
    </inertial>
  </link>

  <!-- upperarm / Oberarm [HW/CAD]: TR5_Modell_V1_Oberarm_v8_1.stl -->
  <link name="link2">
    <visual>
      <origin xyz="0.035 0.052 -0.3" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/upperarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rob3_red"/>
    </visual>
    <collision>
      <origin xyz="0.035 0.052 -0.3" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/upperarm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.0005 0.052 0.0006" rpy="0 0 0"/>
      <mass value="0.8917"/>
      <inertia ixx="0.001415" iyy="0.010071" izz="0.010112" ixy="0" iyz="0" ixz="-9.3e-05"/>
    </inertial>
  </link>

  <!-- forearm / Unterarm [HW/CAD]: TR5_Modell_V1_Unterarm_v4_1.stl.
       In this link frame the mesh runs x = -0.023 .. 0.148 (tip at ~0.148). -->
  <link name="link3">
    <visual>
      <origin xyz="-0.165 0.033 -0.3" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rob3_red"/>
    </visual>
    <collision>
      <origin xyz="-0.165 0.033 -0.3" rpy="0 0 0"/>
      <geometry>
        <mesh filename="meshes/forearm.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0.044 0.033 0.001" rpy="0 0 0"/>
      <mass value="0.2256"/>
      <inertia ixx="0.000178" iyy="0.000502" izz="0.000563" ixy="1e-06" iyz="0" ixz="-1.3e-05"/>
    </inertial>
  </link>

  <!-- =========== CAD-MISSING stand-in links [INFER] ===========
       The 3D CAD does not model the wrist (pitch/roll) or the gripper
       (3D_CAD/Information: "the Gripper is missing and also some Details").
       These are primitive placeholders attached at the forearm tip so the
       firmware's 6-axis state still renders. Geometry is approximate; replace
       with CAD meshes when the 3D model is completed. -->

  <!-- STAND-IN: wrist pitch housing -->
  <link name="link4">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
      <material name="rob3_black"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.02"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- STAND-IN: wrist roll stub -->
  <link name="link5">
    <visual>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.016"/>
      </geometry>
      <material name="rob3_black"/>
    </visual>
    <collision>
      <origin xyz="0.02 0 0" rpy="0 1.5708 0"/>
      <geometry>
        <cylinder length="0.04" radius="0.016"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.08"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- STAND-IN: gripper body -->
  <!-- Gripper (axis 5): CAD mesh built from bench measurements by
       cad/gripper.py (OPEN pose, Ø17×50 cylinder + palm + two-finger four-bar).
       Mesh is in mm (scale 0.001). Its cylinder runs +Z and fingers -Z in the
       mesh frame; rpy rotates it so the cylinder aligns with the wrist mount.
       See hardware/mechanics.md (Gripper) for the dimensions. -->
  <link name="gripper_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/gripper.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="rob3_black"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 -1.5708"/>
      <geometry>
        <mesh filename="meshes/gripper.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.1"/>
      <inertia ixx="1e-4" ixy="0" ixz="0" iyy="1e-4" iyz="0" izz="1e-4"/>
    </inertial>
  </link>

  <!-- ================= Joints ================= -->

  <!-- Axis 0: base rotation (q1) +80..-80 deg  [CAD joint "Umdrehung 14", axis Z] -->
  <joint name="base" type="revolute">
    <parent link="base_link"/>
    <child link="link1"/>
    <origin xyz="-0.035 0 0.1" rpy="0 0 0"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.3962634" upper="1.3962634" effort="10" velocity="1.0"/>
  </joint>

  <!-- Axis 1: shoulder (q2) +70..-30 deg  [CAD joint "Gelenk 2", axis Y] -->
  <joint name="shoulder" type="revolute">
    <parent link="link1"/>
    <child link="link2"/>
    <origin xyz="0 -0.052 0.2" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-0.5235987" upper="1.2217304" effort="10" velocity="1.0"/>
  </joint>

  <!-- Axis 2: elbow (q3) 0..-100 deg  [CAD joint "Gelenk 3", axis Y] -->
  <joint name="elbow" type="revolute">
    <parent link="link2"/>
    <child link="link3"/>
    <origin xyz="0.2 0.019 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7453292" upper="0.0" effort="8" velocity="1.0"/>
  </joint>

  <!-- Axis 3: wrist pitch (q4) +/-100 deg  [STAND-IN: not in CAD].
       Attached at the forearm tip (link3 frame x ~= 0.148, y ~= 0.033). -->
  <joint name="wrist_pitch" type="revolute">
    <parent link="link3"/>
    <child link="link4"/>
    <origin xyz="0.148 0.033 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="5" velocity="1.5"/>
  </joint>

  <!-- Axis 4: wrist roll (q5) +/-100 deg  [STAND-IN: not in CAD] -->
  <joint name="wrist_roll" type="revolute">
    <parent link="link4"/>
    <child link="link5"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="1 0 0"/>
    <limit lower="-1.7453292" upper="1.7453292" effort="5" velocity="1.5"/>
  </joint>

  <!-- Axis 5: gripper linear opening 0..60 mm (prismatic)  [STAND-IN: not in CAD] -->
  <joint name="gripper" type="prismatic">
    <parent link="link5"/>
    <child link="gripper_link"/>
    <origin xyz="0.04 0 0" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
    <limit lower="0.0" upper="0.060" effort="20" velocity="0.05"/>
  </joint>

</robot>
